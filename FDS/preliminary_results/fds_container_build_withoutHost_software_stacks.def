# The below code represents the intial installation of FDS container using Ubuntu image and not inclusive of Host software module stacks (OpenMPI and GCC)

Bootstrap: docker
From: ubuntu:22.04

%environment
    export PATH=/opt/fds/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y \
        build-essential \
        gfortran \
        gcc \
        g++ \
        git \
        cmake \
        make \
        openmpi-bin \
        libopenmpi-dev \
        libfftw3-dev \
        zlib1g-dev \
        python3 \
        python3-pip \
        wget \
        curl \
        ca-certificates \
        bash

    cd /opt

    echo "==> Cloning FDS"
    git clone https://github.com/firemodels/fds.git

    mkdir -p /opt/fds/bin

    echo "==> Building FDS"
    cd /opt/fds/Build/ompi_gnu_linux
    ./make_fds.sh

    cp fds_ompi_gnu_linux /opt/fds/bin/fds

    echo "==> Testing FDS"
    /opt/fds/bin/fds -v || true

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%labels
    Author Deeksha Gopal
    Description FDS Apptainer container for MPI performance comparison

%runscript
    exec /opt/fds/bin/fds "$@"

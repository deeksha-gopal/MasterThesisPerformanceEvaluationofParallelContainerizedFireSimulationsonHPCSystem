Bootstrap: docker
From: almalinux:9

%labels
    Author Deeksha_Gopal
    Application PATO-3.1
    OpenFOAM OpenFOAM-7
    Compiler GCC-12.3.0
    MPI OpenMPI-4.1.5
    Communication UCX
    BuildType Host-EasyBuild-MPI

%setup
    # Create the mount destination inside the container root filesystem.
    mkdir -p "${APPTAINER_ROOTFS}/beegfs/Tools"

%files
    /beegfs/gopal/new/pato/host_mpi_env.sh /opt/host_mpi_env.sh

%environment
    export FOAM_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_DIR=/opt/OpenFOAM/OpenFOAM-7
    export WM_THIRD_PARTY_DIR=/opt/OpenFOAM/ThirdParty-7

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt

    export PATO_DIR=/opt/pato-3.1

    if [ -f /opt/host_mpi_env.sh ]; then
        . /opt/host_mpi_env.sh
    fi

%post -c /bin/bash
    set -ex
    set -o pipefail
  
    # Basic build configuration
    export FOAM_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_DIR=/opt/OpenFOAM/OpenFOAM-7
    export WM_THIRD_PARTY_DIR=/opt/OpenFOAM/ThirdParty-7

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt

    export PATO_DIR=/opt/pato-3.1

    NBUILD="${APPTAINER_BUILD_CPUS:-16}"
    export WM_NCOMPPROCS="$NBUILD"

    echo "============================================================"
    echo "PATO container build configuration"
    echo "============================================================"
    echo "FOAM_INST_DIR=$FOAM_INST_DIR"
    echo "WM_PROJECT_DIR=$WM_PROJECT_DIR"
    echo "WM_THIRD_PARTY_DIR=$WM_THIRD_PARTY_DIR"
    echo "PATO_DIR=$PATO_DIR"
    echo "Parallel build processes=$NBUILD"
    echo "============================================================"

    # Install AlmaLinux dependencies
    echo "============================================================"
    echo "Installing AlmaLinux build dependencies"
    echo "============================================================"

    dnf -y update

    dnf -y install dnf-plugins-core

    echo "============================================================"
    echo "Enabling AlmaLinux CRB repository"
    echo "============================================================"

    dnf config-manager --set-enabled crb

    echo "============================================================"
    echo "Installing EPEL repository"
    echo "============================================================"

    dnf -y install epel-release

    echo "============================================================"
    echo "Enabled repositories"
    echo "============================================================"

    dnf repolist

    echo "============================================================"
    echo "Installing OpenFOAM and PATO dependencies"
    echo "============================================================"

    # Do not install the full AlmaLinux curl package.
    # AlmaLinux already contains curl-minimal, which conflicts with curl.
    # Git and wget are used for downloading the source code.
    dnf -y install \
        bash \
        bc \
        binutils \
        bison \
        boost-devel \
        ca-certificates \
        cmake \
        diffutils \
        file \
        findutils \
        flex \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        git \
        glibc-devel \
        gzip \
        hostname \
        libibverbs \
        libibverbs-devel \
        libquadmath \
        librdmacm \
        librdmacm-devel \
        libstdc++-devel \
        libX11-devel \
        libXext-devel \
        libXrender-devel \
        libXt-devel \
        m4 \
        make \
        openssl-devel \
        patch \
        perl \
        python3 \
        python3-pip \
        readline-devel \
        scotch \
        scotch-devel \
        tar \
        unzip \
        util-linux \
        vim-minimal \
        wget \
        which \
        xz \
        zip \
        zlib-devel

    ldconfig

    dnf clean all
    rm -rf /var/cache/dnf
      
    # Load host EasyBuild GCC and OpenMPI environment
    echo "============================================================"
    echo "Loading host EasyBuild compiler and MPI environment"
    echo "============================================================"

    if [ ! -f /opt/host_mpi_env.sh ]; then
        echo "ERROR: /opt/host_mpi_env.sh was not copied into the image."
        exit 10
    fi

    # host_mpi_env.sh is generated by pato_build.sh.
    . /opt/host_mpi_env.sh

    echo
    echo "MPI_HOME=${MPI_HOME:-not-set}"
    echo

    echo "gcc:"
    command -v gcc
    gcc --version | head -n 1

    echo
    echo "g++:"
    command -v g++
    g++ --version | head -n 1

    echo
    echo "gfortran:"
    command -v gfortran
    gfortran --version | head -n 1

    echo
    echo "mpicc:"
    command -v mpicc
    mpicc --version | head -n 1

    echo
    echo "mpicxx:"
    command -v mpicxx
    mpicxx --version | head -n 1

    echo
    echo "mpirun:"
    command -v mpirun
    mpirun --version

    MPI_VERSION="$(mpirun --version | head -n 1)"

    case "$MPI_VERSION" in
        *4.1.5*)
            echo "SUCCESS: OpenMPI 4.1.5 detected."
            ;;
        *)
            echo "ERROR: Expected OpenMPI 4.1.5."
            echo "Detected: $MPI_VERSION"
            exit 11
            ;;
    esac

    # Check UCX and RDMA support
    echo "============================================================"
    echo "Checking OpenMPI UCX support"
    echo "============================================================"

    UCX_OUTPUT=/tmp/openmpi_ucx_check.txt

    ompi_info --param pml ucx --level 1 \
        > "$UCX_OUTPUT" 2>&1 || true

    cat "$UCX_OUTPUT"

    if ! grep -q "MCA pml: ucx" "$UCX_OUTPUT"; then
        echo "ERROR: OpenMPI UCX PML component is unavailable."
        exit 12
    fi

    echo "SUCCESS: OpenMPI UCX PML component is available."

    echo "============================================================"
    echo "Checking RDMA libraries"
    echo "============================================================"

    ldconfig -p | grep -E 'libibverbs|librdmacm' || true

    if ! ldconfig -p | grep -q 'libibverbs.so.1'; then
        echo "ERROR: libibverbs.so.1 is unavailable."
        exit 13
    fi

    if ! ldconfig -p | grep -q 'librdmacm.so.1'; then
        echo "ERROR: librdmacm.so.1 is unavailable."
        exit 14
    fi

    echo "SUCCESS: RDMA runtime libraries are available."

    # Download OpenFOAM-7 and ThirdParty-7
    echo "============================================================"
    echo "Downloading OpenFOAM-7 and ThirdParty-7"
    echo "============================================================"

    mkdir -p /opt/OpenFOAM
    cd /opt/OpenFOAM

    rm -rf \
        /opt/OpenFOAM/OpenFOAM-7 \
        /opt/OpenFOAM/ThirdParty-7

    echo "Cloning OpenFOAM-7"

    git clone \
        --depth 1 \
        https://github.com/OpenFOAM/OpenFOAM-7.git \
        /opt/OpenFOAM/OpenFOAM-7

    echo "Cloning ThirdParty-7"

    git clone \
        --depth 1 \
        https://github.com/OpenFOAM/ThirdParty-7.git \
        /opt/OpenFOAM/ThirdParty-7

    if [ ! -d /opt/OpenFOAM/OpenFOAM-7 ]; then
        echo "ERROR: OpenFOAM-7 source directory was not created."
        exit 20
    fi

    if [ ! -f /opt/OpenFOAM/OpenFOAM-7/Allwmake ]; then
        echo "ERROR: OpenFOAM-7 Allwmake was not found."
        exit 21
    fi

    if [ ! -d /opt/OpenFOAM/ThirdParty-7 ]; then
        echo "ERROR: ThirdParty-7 source directory was not created."
        exit 22
    fi

    echo
    echo "OpenFOAM-7 source revision:"
    git -C /opt/OpenFOAM/OpenFOAM-7 log -1 --oneline

    echo
    echo "ThirdParty-7 source revision:"
    git -C /opt/OpenFOAM/ThirdParty-7 log -1 --oneline

    # Patch OpenFOAM-7 OSHA1stream for GCC 12
    echo "============================================================"
    echo "Applying OpenFOAM-7 GCC 12 OSHA1stream compatibility patch"
    echo "============================================================"

    OSHA1_FILE="/opt/OpenFOAM/OpenFOAM-7/src/OpenFOAM/db/IOstreams/hashes/OSHA1stream.H"

    if [ ! -f "$OSHA1_FILE" ]; then
        echo "ERROR: OSHA1stream.H was not found:"
        echo "$OSHA1_FILE"
        exit 28
    fi

    # Keep a copy of the original source file inside the image.
    cp "$OSHA1_FILE" "${OSHA1_FILE}.before_gcc12_fix"

    python3 - "$OSHA1_FILE" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text()

patch_marker = "virtual int overflow(int c = EOF)"

old_block = """        virtual std::streamsize xsputn(const char* str, std::streamsize n)
        {
            sha1_.append(str, n);
            return n;
        }
"""

new_block = """        virtual std::streamsize xsputn(const char* str, std::streamsize n)
        {
            sha1_.append(str, n);
            return n;
        }

        //- Write one character to the SHA1 stream.
        //  Required for compatibility with GCC 12 streambuf behaviour.
        virtual int overflow(int c = EOF)
        {
            if (c != EOF)
            {
                const char cc = c;
                sha1_.append(&cc, 1);
            }

            return c;
        }
"""

if patch_marker in text:
    print("OSHA1stream GCC 12 patch is already present.")
elif old_block not in text:
    print("ERROR: Expected xsputn block was not found.")
    print(f"File: {path}")
    raise SystemExit(1)
else:
    path.write_text(text.replace(old_block, new_block, 1))
    print("SUCCESS: Applied OSHA1stream GCC 12 patch.")
PY

    if ! grep -q "virtual int overflow(int c = EOF)" "$OSHA1_FILE"; then
        echo "ERROR: OSHA1stream patch verification failed."
        exit 29
    fi

    echo
    echo "Patched section:"
    grep -n -A15 -B5 \
        "virtual int overflow" \
        "$OSHA1_FILE"

    echo
    echo "SUCCESS: OpenFOAM-7 GCC 12 patch verified."

    # Prepare OpenFOAM-7 build environment
    echo "============================================================"
    echo "Preparing OpenFOAM-7 build environment"
    echo "============================================================"

    export FOAM_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_DIR=/opt/OpenFOAM/OpenFOAM-7
    export WM_THIRD_PARTY_DIR=/opt/OpenFOAM/ThirdParty-7

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export WM_NCOMPPROCS="$NBUILD"

    cd "$WM_PROJECT_DIR"

    echo "============================================================"
    echo "Loading OpenFOAM-7 environment"
    echo "============================================================"

    # OpenFOAM-7's bashrc contains ordinary shell tests that may return 1.
    # Disable errexit, nounset, pipefail and tracing while sourcing it.
    set +e
    set +u
    set +o pipefail
    set +x

    . "$WM_PROJECT_DIR/etc/bashrc"

    # Restore strict build behavior.
    set -x
    set -e
    set -o pipefail

    # Reassert the requested compiler and MPI configuration.
    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export WM_NCOMPPROCS="$NBUILD"

    # Verify the environment instead of relying on the bashrc return status.
    if [ -z "${WM_PROJECT_DIR:-}" ]; then
        echo "ERROR: WM_PROJECT_DIR is unset after sourcing OpenFOAM."
        exit 23
    fi

    if [ ! -d "$WM_PROJECT_DIR" ]; then
        echo "ERROR: WM_PROJECT_DIR does not exist:"
        echo "$WM_PROJECT_DIR"
        exit 24
    fi

    if [ -z "${WM_OPTIONS:-}" ]; then
        echo "ERROR: WM_OPTIONS was not initialized."
        exit 25
    fi

    if [ -z "${FOAM_SRC:-}" ]; then
        echo "ERROR: FOAM_SRC was not initialized."
        exit 26
    fi

    if ! command -v wmake >/dev/null 2>&1; then
        echo "ERROR: wmake is unavailable after sourcing OpenFOAM."
        exit 27
    fi

    echo
    echo "OpenFOAM build environment:"
    echo "FOAM_INST_DIR=$FOAM_INST_DIR"
    echo "WM_PROJECT_INST_DIR=$WM_PROJECT_INST_DIR"
    echo "WM_PROJECT_DIR=$WM_PROJECT_DIR"
    echo "WM_THIRD_PARTY_DIR=$WM_THIRD_PARTY_DIR"
    echo "WM_COMPILER_TYPE=$WM_COMPILER_TYPE"
    echo "WM_COMPILER=$WM_COMPILER"
    echo "WM_MPLIB=$WM_MPLIB"
    echo "WM_OPTIONS=${WM_OPTIONS:-not-set}"
    echo "FOAM_MPI=${FOAM_MPI:-not-set}"
    echo "FOAM_SRC=${FOAM_SRC:-not-set}"
    echo "FOAM_APPBIN=${FOAM_APPBIN:-not-set}"
    echo "FOAM_LIBBIN=${FOAM_LIBBIN:-not-set}"
    echo

    echo "Compiler and MPI used for OpenFOAM:"
    command -v gcc
    command -v g++
    command -v mpicc
    command -v mpicxx
    command -v mpirun
    command -v wmake

    echo
    echo "Compiler versions:"
    gcc --version | head -n 1
    g++ --version | head -n 1

    echo
    echo "MPI version:"
    mpirun --version | head -n 1

    echo
    echo "MPI compiler flags:"
    mpicxx --showme:compile || true

    echo
    echo "MPI linker flags:"
    mpicxx --showme:link || true

    # Build OpenFOAM-7
    echo "============================================================"
    echo "Building OpenFOAM-7 with ${NBUILD} parallel build processes"
    echo "============================================================"

    cd "$WM_PROJECT_DIR"

    set +e

    ./Allwmake -j "$NBUILD" \
        2>&1 | tee "$WM_PROJECT_DIR/build.log"

    OPENFOAM_BUILD_RC="${PIPESTATUS[0]}"

    set -e

    if [ "$OPENFOAM_BUILD_RC" -ne 0 ]; then
        echo "============================================================"
        echo "ERROR: OpenFOAM-7 compilation failed"
        echo "Allwmake exit code: $OPENFOAM_BUILD_RC"
        echo "============================================================"

        echo
        echo "Last 250 lines of the OpenFOAM build log:"
        tail -n 250 "$WM_PROJECT_DIR/build.log" || true

        exit 30
    fi

    echo "============================================================"
    echo "OpenFOAM-7 compilation completed successfully"
    echo "============================================================"

    # Reload and verify OpenFOAM-7
    echo "============================================================"
    echo "Verifying OpenFOAM-7 build"
    echo "============================================================"

    set +e
    set +u
    set +o pipefail
    set +x

    . "$WM_PROJECT_DIR/etc/bashrc"

    set -x
    set -e
    set -o pipefail

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export WM_NCOMPPROCS="$NBUILD"

    echo
    echo "OpenFOAM installation variables:"
    echo "WM_PROJECT_DIR=$WM_PROJECT_DIR"
    echo "WM_OPTIONS=${WM_OPTIONS:-not-set}"
    echo "FOAM_APPBIN=${FOAM_APPBIN:-not-set}"
    echo "FOAM_LIBBIN=${FOAM_LIBBIN:-not-set}"
    echo "FOAM_MPI=${FOAM_MPI:-not-set}"
    echo

    for command_name in \
        wmake \
        blockMesh \
        decomposePar \
        reconstructPar
    do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            echo "ERROR: $command_name was not created or is not in PATH."
            exit 31
        fi

        echo "$command_name: $(command -v "$command_name")"
    done

    BLOCKMESH_BIN="$(command -v blockMesh)"

    echo
    echo "Checking blockMesh library dependencies:"
    ldd "$BLOCKMESH_BIN"

    if ldd "$BLOCKMESH_BIN" | grep -q "not found"; then
        echo "ERROR: blockMesh contains unresolved libraries."
        ldd "$BLOCKMESH_BIN" | grep "not found" || true
        exit 32
    fi

    echo "SUCCESS: OpenFOAM-7 executables were built successfully."

    # Download PATO-3.1
    echo "============================================================"
    echo "Downloading NASA PATO-3.1"
    echo "============================================================"

    rm -rf /opt/pato-3.1

    git clone \
        --depth 1 \
        https://github.com/nasa/pato.git \
        /opt/pato-3.1

    if [ ! -d /opt/pato-3.1 ]; then
        echo "ERROR: /opt/pato-3.1 was not created."
        exit 40
    fi

    if [ ! -f /opt/pato-3.1/bashrc ]; then
        echo "ERROR: PATO bashrc was not found."
        exit 41
    fi

    if [ ! -f /opt/pato-3.1/Allwmake ]; then
        echo "ERROR: PATO Allwmake was not found."
        exit 42
    fi

    chmod +x /opt/pato-3.1/Allwmake

    echo
    echo "PATO source revision:"
    git -C /opt/pato-3.1 log -1 --oneline

    # Prepare PATO build environment
    echo "============================================================"
    echo "Preparing PATO-3.1 build environment"
    echo "============================================================"

    export FOAM_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_DIR=/opt/OpenFOAM/OpenFOAM-7
    export WM_THIRD_PARTY_DIR=/opt/OpenFOAM/ThirdParty-7

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export WM_NCOMPPROCS="$NBUILD"

    export PATO_DIR=/opt/pato-3.1

    # Both OpenFOAM and PATO environment files may use normal commands that return status 1 as part of conditional checks.
    set +e
    set +u
    set +o pipefail
    set +x

    . "$WM_PROJECT_DIR/etc/bashrc"
    . "$PATO_DIR/bashrc"

    set -x
    set -e
    set -o pipefail

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export WM_NCOMPPROCS="$NBUILD"

    if ! command -v wmake >/dev/null 2>&1; then
        echo "ERROR: wmake is unavailable in the PATO environment."
        exit 43
    fi

    echo
    echo "PATO build environment:"
    echo "PATO_DIR=$PATO_DIR"
    echo "WM_PROJECT_DIR=$WM_PROJECT_DIR"
    echo "WM_OPTIONS=${WM_OPTIONS:-not-set}"
    echo "WM_COMPILER=$WM_COMPILER"
    echo "WM_MPLIB=$WM_MPLIB"
    echo "FOAM_MPI=${FOAM_MPI:-not-set}"
    echo "FOAM_APPBIN=${FOAM_APPBIN:-not-set}"
    echo "FOAM_LIBBIN=${FOAM_LIBBIN:-not-set}"
    echo

    echo "Build tools:"
    command -v wmake
    command -v gcc
    command -v g++
    command -v mpicc
    command -v mpicxx
    command -v mpirun

    # Build PATO-3.1
    echo "============================================================"
    echo "Building PATO-3.1 with ${NBUILD} parallel build processes"
    echo "============================================================"

    cd "$PATO_DIR"

    set +e

    ./Allwmake -j "$NBUILD" \
        2>&1 | tee "$PATO_DIR/build.log"

    PATO_BUILD_RC="${PIPESTATUS[0]}"

    set -e

    if [ "$PATO_BUILD_RC" -ne 0 ]; then
        echo "============================================================"
        echo "ERROR: PATO-3.1 compilation failed"
        echo "Allwmake exit code: $PATO_BUILD_RC"
        echo "============================================================"

        echo
        echo "Last 250 lines of the PATO build log:"
        tail -n 250 "$PATO_DIR/build.log" || true

        exit 44
    fi

    echo "============================================================"
    echo "PATO-3.1 compilation completed successfully"
    echo "============================================================"

    # Reload and verify PATO-3.1
    echo "============================================================"
    echo "Verifying PATO-3.1 build"
    echo "============================================================"

    set +e
    set +u
    set +o pipefail
    set +x

    . "$WM_PROJECT_DIR/etc/bashrc"
    . "$PATO_DIR/bashrc"

    set -x
    set -e
    set -o pipefail

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt

    PATO_BIN=""

    if command -v PATOx >/dev/null 2>&1; then
        PATO_BIN="$(command -v PATOx)"
    else
        PATO_BIN="$(
            find \
                "$PATO_DIR" \
                "${FOAM_APPBIN:-/nonexistent}" \
                -type f \
                -name PATOx \
                -perm /111 \
                2>/dev/null |
            head -n 1
        )"
    fi

    if [ -z "$PATO_BIN" ] || [ ! -x "$PATO_BIN" ]; then
        echo "ERROR: PATOx was not created."
        echo
        echo "Files whose names begin with PATO:"
        find /opt/pato-3.1 /opt/OpenFOAM \
            -type f \
            -name 'PATO*' \
            2>/dev/null || true

        echo
        echo "Last 250 lines of PATO build.log:"
        tail -n 250 "$PATO_DIR/build.log" || true

        exit 50
    fi

    echo
    echo "PATO executable:"
    echo "$PATO_BIN"
    echo

    echo "PATOx library dependencies:"
    ldd "$PATO_BIN"

    if ldd "$PATO_BIN" | grep -q "not found"; then
        echo "ERROR: PATOx contains unresolved shared libraries."
        ldd "$PATO_BIN" | grep "not found" || true
        exit 51
    fi

    # Verify MPI linkage
    echo "============================================================"
    echo "Verifying OpenMPI linkage"
    echo "============================================================"

    MPI_LIBRARY="$(
        ldd "$PATO_BIN" |
        awk '/libmpi\.so/{print $3; exit}'
    )"

    if [ -z "$MPI_LIBRARY" ]; then
        echo "libmpi is not directly listed by PATOx."
        echo "Checking OpenFOAM Pstream libraries."

        PSTREAM_LIBRARY="$(
            find "$FOAM_LIBBIN" \
                -type f \
                \( \
                    -name 'libPstream.so' \
                    -o -name 'libPstream*.so' \
                \) \
                2>/dev/null |
            head -n 1
        )"

        if [ -z "$PSTREAM_LIBRARY" ]; then
            echo "Checking MPI-specific OpenFOAM libraries."

            PSTREAM_LIBRARY="$(
                find "$FOAM_LIBBIN" \
                    -type f \
                    -name '*.so' \
                    -print0 \
                    2>/dev/null |
                xargs -0 -r grep -l 'MPI_' 2>/dev/null |
                head -n 1
            )"
        fi

        if [ -n "$PSTREAM_LIBRARY" ]; then
            echo
            echo "OpenFOAM MPI library:"
            echo "$PSTREAM_LIBRARY"

            ldd "$PSTREAM_LIBRARY" || true

            MPI_LIBRARY="$(
                ldd "$PSTREAM_LIBRARY" |
                awk '/libmpi\.so/{print $3; exit}'
            )"
        fi
    fi

    echo
    echo "Resolved libmpi:"
    echo "${MPI_LIBRARY:-not-found}"
    echo

    case "${MPI_LIBRARY:-}" in
        /beegfs/Tools/*/OpenMPI/4.1.5-GCC-12.3.0/*)
            echo "SUCCESS: PATO/OpenFOAM uses host OpenMPI 4.1.5."
            ;;
        "")
            echo "ERROR: Could not determine the OpenMPI library linkage."
            exit 52
            ;;
        *)
            echo "ERROR: An unexpected MPI library was resolved:"
            echo "$MPI_LIBRARY"
            exit 53
            ;;
    esac

    echo
    echo "MPI and communication-related libraries:"

    ldd "$PATO_BIN" |
        grep -E \
        'libmpi|libopen-rte|libopen-pal|libpmix|libucp|libucs|libuct|libucm|libibverbs|librdmacm|libhwloc' \
        || true

    # Final checks and cleanup
    echo "============================================================"
    echo "Final container checks"
    echo "============================================================"

    command -v gcc
    command -v mpicc
    command -v mpirun
    command -v blockMesh

    echo
    echo "PATOx:"
    echo "$PATO_BIN"

    echo
    echo "OpenMPI:"
    mpirun --version | head -n 1

    echo
    echo "UCX:"
    ompi_info --param pml ucx --level 1 || true

    echo "============================================================"
    echo "OpenFOAM-7 and PATO-3.1 built successfully"
    echo "============================================================"

%runscript
    #!/bin/bash

    set -e

    if [ ! -f /opt/host_mpi_env.sh ]; then
        echo "ERROR: /opt/host_mpi_env.sh is unavailable."
        exit 1
    fi

    . /opt/host_mpi_env.sh

    export FOAM_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_INST_DIR=/opt/OpenFOAM
    export WM_PROJECT_DIR=/opt/OpenFOAM/OpenFOAM-7
    export WM_THIRD_PARTY_DIR=/opt/OpenFOAM/ThirdParty-7

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt

    export PATO_DIR=/opt/pato-3.1
    export PATO_BIN=/opt/pato-3.1/install/bin/PATOx

    set +e
    set +u
    set +o pipefail

    . "$WM_PROJECT_DIR/etc/bashrc"
    . "$PATO_DIR/bashrc"

    set -e

    export WM_COMPILER_TYPE=system
    export WM_COMPILER=Gcc
    export WM_MPLIB=SYSTEMOPENMPI
    export WM_PRECISION_OPTION=DP
    export WM_LABEL_SIZE=32
    export WM_COMPILE_OPTION=Opt
    export PATH="$PATO_DIR/install/bin:${PATH}"

    if [ -z "${WM_OPTIONS:-}" ]; then
        echo "ERROR: OpenFOAM environment was not initialized."
        exit 2
    fi
    
    if ! command -v blockMesh >/dev/null 2>&1; then
        echo "ERROR: blockMesh is unavailable."
        exit 3
    fi

    if [ ! -x "$PATO_BIN" ]; then
        echo "ERROR: PATOx executable is unavailable:"
        echo "$PATO_BIN"
        exit 4
    fi

    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi

    exec "$@"
